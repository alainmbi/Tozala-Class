<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script>
      try {
        if (localStorage.getItem('tozala-theme') === 'dark') document.documentElement.dataset.theme = 'dark'
      } catch (error) {}
    </script>
    <title inertia>
      AdonisJS
    </title>

    @viteReactRefresh()
    @vite(['resources/js/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    <div id="brand-loader-root">
    </div>
    @inertia()
  </body>

</html>
